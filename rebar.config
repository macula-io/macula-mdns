%% -*- mode: erlang -*-
%% rebar3 configuration for macula_mdns
%% Fork of shortishly/mdns with rebar3 support

{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{deps, [
    %% 0.9.1 -> 1.3.0: audited commit-by-commit across all 4 tag jumps
    %% (macula-io/macula CHANGELOG 10.20.0 has the full trace) -- purely
    %% additive remote-registration API + internal non-exported
    %% refactors + an OTP 29 warnings fix, no removed/changed exported
    %% function. This lib's own gproc surface (gproc:reg/1, gproc:send/2,
    %% gproc:goodbye/0, {via, gproc, ...} in mdns_advertise/mdns_discover)
    %% is untouched by any of it. Loosened to `~>' per policy -- the
    %% previous exact "0.9.1" pin made macula's own gproc bump
    %% unsatisfiable for every consumer resolving both packages together.
    {gproc, "~> 1.3"},
    {macula_envy, "~> 0.1.1"}
]}.

{project_plugins, [
    rebar3_hex,
    rebar3_ex_doc
]}.

%% Hex package configuration
{hex, [
    {name, macula_mdns},
    {doc, #{provider => ex_doc}},
    {licenses, ["Apache-2.0"]},
    {links, #{
        <<"GitHub">> => <<"https://github.com/macula-io/macula-mdns">>,
        <<"Original">> => <<"https://github.com/shortishly/mdns">>
    }},
    {description, "Multicast DNS (mDNS/Zeroconf/Bonjour) for Erlang/OTP (rebar3 fork of shortishly/mdns)"}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-io/macula-mdns">>},
    {extras, ["README.md", "CHANGELOG.md", "LICENSE"]},
    {main, "README.md"}
]}.

{profiles, [
    {lint, [
        {plugins, [{rebar3_lint, "5.0.4"}]}
    ]}
]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [ #{files => ["src/**/*.erl"], ruleset => macula_min} ]}
]}.
